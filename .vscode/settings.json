{
  // ========== Visuals ==========
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontFamily": "Dank Mono",
  "editor.guides.bracketPairs": "active",
  "editor.lineNumbers": "interval",
  "editor.renderWhitespace": "boundary",
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabActionLocation": "left",
  "window.autoDetectColorScheme": true,
  "workbench.iconTheme": "file-icons-colourless",
  "workbench.list.smoothScrolling": true,
  "workbench.preferredDarkColorTheme": "Vitesse Dark Soft",
  "workbench.preferredLightColorTheme": "Vitesse Dark Soft",
  "workbench.productIconTheme": "icons-carbon",
  "workbench.sideBar.location": "right",
  "workbench.tree.expandMode": "singleClick",
  "workbench.tree.indent": 10,

  // ========== Editor ==========
  "debug.console.fontSize": 16,
  "debug.onTaskErrors": "debugAnyway",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  "editor.find.addExtraSpaceOnTop": false,
  "editor.inlineSuggest.enabled": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.fontSize": 18,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.stickyScroll.enabled": true,
  "editor.hover.sticky": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "common italic",
        "scope": [
          "keyword.control.import",
          "keyword.control.from",
          "keyword.control.export",
          "entity.name.function",
          "meta.object-literal.key"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "name": "vue sfc italic",
        "scope": [
          "source.vue meta.tag.custom.start entity.other.attribute-name.html.vue",
          "source.vue meta.tag.custom.start meta.attribute.class.html",
          "source.vue meta.tag.custom.start meta.attribute.style.html",
          "source.vue meta.tag.custom.start entity.other.attribute-name.html",
          "source.vue meta.attribute.directive.vue entity.other.attribute-name.html.vue",
          "source.vue meta.attribute.lang.html",
          "source.vue meta.attribute.unrecognized.setup.html",
          "source.vue meta.attribute.unrecognized.ref.html",
          "source.vue meta.attribute.unrecognized.scoped.html",
          "source.vue meta.attribute.unrecognized.slot.html",
          "source.vue keyword.control.loop.vue",
          "keyword.control.conditional.vue"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.untrackedChanges": "separate",
  "scm.diffDecorationsGutterWidth": 2,
  "scm.inputFontSize": 16,
  "scm.inputMinLineCount": 3,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.fontSize": 20,
  "terminal.integrated.fontWeight": "300",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.tabs.enabled": true,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 5,
  "search.exclude": {
    "**/*.snap": true,
    "**/*.svg": true,
    "**/.git": true,
    "**/.github": false,
    "**/.nuxt": true,
    "**/.output": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/assets": true,
    "**/bower_components": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/out/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/public": true,
    "**/temp": true,
    "**/yarn.lock": true,
    "**/CHANGELOG*": true,
    "**/LICENSE*": true,
  },

  // ========== Extension configs ==========
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": false,
  "errorLens.enabledDiagnosticLevels": [
    "warning",
    "error"
  ],
  "errorLens.excludeBySource": [
    "cSpell",
    "Grammarly",
    "eslint"
  ],
  "colorize.languages": [
      "javascript",
      "typescript",
      "vue",
      "css",
      "less",
      "scss"
  ],
  "css.lint.hexColorLength": "ignore",
  "cSpell.allowCompoundWords": true,
  "cSpell.language": "en,en-US,lorem,en-GB",
  "cSpell.userWords": [
    "airace",
    "amap",
    "animejs",
    "arcgis",
    "axios",
    "bbox",
    "cascader",
    "cgcs",
    "colour",
    "corejs",
    "dppx",
    "echarts",
    "endregion",
    "epsg",
    "fxaa",
    "geoserver",
    "glsl",
    "gltf",
    "ibps",
    "iconfont",
    "iconify",
    "konva",
    "latlng",
    "layui",
    "lightningcss",
    "lingma",
    "lods",
    "manypkg",
    "maxx",
    "maxy",
    "miny",
    "mitter",
    "mqtt",
    "nprogress",
    "olcs",
    "openlayers",
    "osgb",
    "oxlint",
    "pinia",
    "postrender",
    "pureadmin",
    "regeo",
    "regeocode",
    "rtmp",
    "sider",
    "singleclick",
    "sseh",
    "styl",
    "tailwindcss",
    "TIANDITU",
    "TILECOL",
    "TILEMATRIX",
    "TILEMATRIXSET",
    "TILEROW",
    "tileset",
    "towncode",
    "tweenjs",
    "typedoc",
    "unbild",
    "unocss",
    "unplugin",
    "unproject",
    "unref",
    "urcop",
    "vite",
    "vitepress",
    "Vitesse",
    "vueuse",
    "wayline",
    "waylines",
    "webgl",
    "webrtc",
    "wireframe",
    "wkid",
    "wms",
    "wmts"
  ],
  "fileNestingUpdater.autoUpdate": true,
  "fileNestingUpdater.autoUpdateInterval": 720,
  "fileNestingUpdater.promptOnAutoUpdate": true,
  "fileNestingUpdater.upstreamRepo": "antfu/vscode-file-nesting-config",
  "fileNestingUpdater.upstreamBranch": "main",
  "gitlens.launchpad.indicator.enabled": false,
  "glsllint.glslangValidatorPath": "D:\\software\\glslang-master-windows-Release\\bin\\glslangValidator.exe",
  "iconify.annotations": true,
  "iconify.inplace": true,
  "svg.preview.mode": "svg",
  "todo-tree.highlights.enabled": true,
  "todo-tree.regex.regex": "((//|#|<!--|;|/\\*|^)\\s*($TAGS):|^\\s*- \\[ \\]|\\*\\s*($TAGS)\\s*:|^\\s*- \\[ \\])",
  "todo-tree.regex.regexCaseSensitive": false,
  "todo-tree.general.tags": [
      "TODO",
      "FIXME",
      "TEST",
      "DONE",
      "NOTE",
      "TAG",
      "[ ]",
      "[x]"
  ],
  "todo-tree.highlights.useColourScheme": true,
  "todo-tree.highlights.defaultHighlight": {
      "icon": "question",
      "type": "tag",
      "rulerLane": "full",
      "foreground": "#000000",
      "background": "#FFFFFF",
      "iconColour": "#FFFFFF",
      "rulerColour": "#000000"
  },
  "todo-tree.highlights.customHighlight": {
      "TODO": {
          "icon": "calendar",
          "background": "#f90",
          "rulerColour": "#f90",
          "iconColour": "#f90"
      },
      "FIXME": {
          "icon": "bug",
          "background": "#eb5c5c",
          "rulerColour": "#eb5c5c",
          "iconColour": "#eb5c5c"
      },
      "TEST": {
          "icon": "beaker",
          "background": "#ee82ee",
          "rulerColour": "#ee82ee",
          "iconColour": "#ee82ee"
      },
      "DONE": {
          "icon": "checklist",
          "background": "#5eec95",
          "rulerColour": "#5eec95",
          "iconColour": "#5eec95"
      },
      "NOTE": {
          "icon": "comment-discussion",
          "foreground": "#444",
          "background": "#c9c5ba",
          "rulerColour": "#c9c5ba",
          "iconColour": "#c9c5ba"
      },
      "TAG": {
          "icon": "tag",
          "background": "#38b2f4",
          "rulerColour": "#38b2f4",
          "iconColour": "#38b2f4"
      },
      "[ ]": {
          "background": "#f90"
      },
      "[x]": {
          "background": "#5eec95"
      }
  },

  // ESLint config: https://github.com/antfu/eslint-config
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "eslint.lintTask.enable": true,
  "eslint.quiet": true,
  // Silent the stylistic rules in you IDE, but still auto fix them
  "eslint.rules.customizations": [
    { "rule": "style/*", "severity": "off" },
    { "rule": "format/*", "severity": "off" },
    { "rule": "*-indent", "severity": "off" },
    { "rule": "*-spacing", "severity": "off" },
    { "rule": "*-spaces", "severity": "off" },
    { "rule": "*-order", "severity": "off" },
    { "rule": "*-dangle", "severity": "off" },
    { "rule": "*-newline", "severity": "off" },
    { "rule": "*quotes", "severity": "off" },
    { "rule": "*semi", "severity": "off" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "toml"
  ],

  // I only use Prettier for manually formatting
  "prettier.enable": true,
  "prettier.printWidth": 120,
  "prettier.useTabs": false,
  "prettier.tabWidth": 2,
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.quoteProps": "as-needed",
  "prettier.jsxSingleQuote": false,
  "prettier.trailingComma": "all",
  "prettier.bracketSpacing": true,
  "prettier.bracketSameLine": false,
  "prettier.arrowParens": "always",
  "prettier.requirePragma": false,
  "prettier.insertPragma": false,
  "prettier.proseWrap": "preserve",
  "prettier.htmlWhitespaceSensitivity": "css",
  "prettier.endOfLine": "lf",

  // ========== File Nesting ==========
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  // fileNesting.patterns will be updated automatically by the extension
  "explorer.fileNesting.patterns": {},
}
